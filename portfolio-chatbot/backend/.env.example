GROQ_API_KEY=your_groq_api_key_here
PORTFOLIO_URL=https://jyotirmoy-portfolio.onrender.com
ALLOWED_ORIGIN=https://jyotirmoy-portfolio.onrender.com
# Optional
# GROQ_MODEL=openai/gpt-oss-120b
# Header carrying the real visitor IP (Render is behind Cloudflare). Empty = socket address, for local runs.
# CLIENT_IP_HEADER=cf-connecting-ip
# Max chat requests per hour across ALL visitors (protects the Groq quota)
# GLOBAL_RATE_LIMIT=300
